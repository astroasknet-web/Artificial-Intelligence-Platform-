NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo requests from /book are emailed with Resend. Without these a dev server logs the request; production refuses (503).
RESEND_API_KEY=
DEMO_TO=hello@example.com
DEMO_FROM=Yugty.AI <onboarding@resend.dev>

# Optional links to the other Yugty portals; a link shows only when its URL is set.
NEXT_PUBLIC_YUGTYJOBS_URL=
NEXT_PUBLIC_YUGTYLEARNING_URL=
NEXT_PUBLIC_YUGTYTECHNOLOGY_URL=
# Origin that serves the career agents (/ai-resume-expert and so on). Empty shows them as plain cards.
NEXT_PUBLIC_AGENTS_URL=
